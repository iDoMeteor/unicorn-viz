+// The callback registries below are process-wide and can be reached from
+// several Python threads at once. Only map operations run under the lock (no
+// Python API calls), and the replaced entry is released after unlocking.
+static std::mutex registered_callbacks_mutex;
+
+static void registerCallbackInfo(std::map<std::string, PyObject*>& registry,
+                                 const std::string& name, PyObject* py_callback_info)
+{
+    PyObject* replaced = NULL;
+    {
+        std::lock_guard<std::mutex> lock(registered_callbacks_mutex);
+        std::map<std::string, PyObject*>::iterator i = registry.find(name);
+        if (i != registry.end())
+        {
+            replaced = i->second;
+            i->second = py_callback_info;
+        }
+        else
+        {
+            registry.insert(std::pair<std::string, PyObject*>(name, py_callback_info));
+        }
+    }
+    Py_XDECREF(replaced);
+}
