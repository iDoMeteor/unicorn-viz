# spotifyd configuration template for Unicorn Viz background training daemon.
#
# Copy this file to ~/.config/unicorn-training/spotifyd.conf and fill in
# your second Spotify Premium account credentials before running training_daemon.py.
#
# spotifyd docs: https://spotifyd.github.io/spotifyd/config/File.html

[global]

# ---- Spotify auth -----------------------------------------------------------
# Option A: username + password (simplest for a dedicated training account).
username = "your.training.account@example.com"
password = "yourpassword"

# Option B: password_cmd — read from a command (safer for shared machines).
# Comment out username/password above and uncomment these two lines:
# username = "your.training.account@example.com"
# password_cmd = "secret-tool lookup service spotifyd account training"

# ---- Device identity --------------------------------------------------------
# This name appears in Spotify's device list — connect to it from any client.
device_name = "Unicorn Training"
device_type = "computer"

# ---- Audio backend ----------------------------------------------------------
# "pulseaudio" works for both PipeWire (via the PulseAudio compat layer)
# and native PulseAudio.  The daemon sets PULSE_SINK=unicorn-training so
# all spotifyd output lands on the dedicated null sink.
backend = "pulseaudio"
bitrate = 320

# ---- Behaviour --------------------------------------------------------------
no_audio_cache = true
volume_normalisation = false
autoplay = false
