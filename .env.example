# API keys for optional LLM detector scoring in tools/package_training_set.py.
# Copy this file to .env and fill in whichever key you have.
# The packaging tool auto-detects: OPENAI_API_KEY is checked first,
# then ANTHROPIC_API_KEY.  Both can coexist; the first populated one is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
